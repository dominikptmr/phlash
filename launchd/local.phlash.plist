<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install.sh fills in @BIN@ and @LOG@. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.phlash</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after a clean exit (stop, "already running"). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Keeps launchd from throttling us; every keystroke passes through the tap. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- For exec bindings: launchd's default PATH lacks Homebrew. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
