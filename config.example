# phlash config ~/.config/phlash/config
# 
# Start phlash: launchctl kickstart gui/$(id -u)/local.phlash
# Reload after editing: pkill -HUP phlash   Check: ~/.local/bin/phlash --check
# 
#   hyper [+ mod ...] - key : action       hold caps lock (Hyper), press key
#   [mod + ...] hyper : action             tap caps lock while holding mods
#   <modifier> : action                    tap a modifier on its own (the
#                                          modifier still reaches the app)
#   set <setting> <value>
#
#   mod      cmd | opt | ctrl | shift
#   modifier cmd | opt | ctrl | shift (either side), lcmd | rcmd | lopt | ropt
#            | lctrl | rctrl | lshift | rshift (one side), fn
#   key     what the key types in your keyboard layout, lowercase (y, ö, #, 1),
#           a name (return, tab, space, delete, escape, left, f5, ...)
#           or a hex keycode like 0x0a
#
# Actions
#   app <name>          jump instantly to the app's window, wherever its
#                       fullscreen space has moved to. Nothing happens if it has
#                       no open window. The name is what `phlash --list`
#                       shows or the .app's name. "app A | B | C" picks the first
#                       one with a window open. Pressing the key again while the
#                       app is in front goes to its next tab ("; tab <shortcut>"
#                       for apps that don't use the default, "; tab none" = off).
#   desktop             first space without a fullscreen app
#   space back          last used space
#   space cycle [prev]  next / previous space, wrapping around
#   tab next | prev     tab of the app in front. On a tap line, the tab switcher
#                       stays open until you let go of the line's modifiers
#                       (shift aside); on a Hyper + key line, until Hyper; on a
#                       modifier tap line it closes right away.
#   window next | prev  window of the app in front, across spaces
#   key <shortcut>      type a shortcut into the app in front, e.g. cmd+t
#   exec <command>      run a shell command


# -----------------------------------------------------------------------------------------------------------

# Settings
#   set tab <shortcut>        next-tab shortcut for apps without "; tab"
#   set tap-ms <50-1000>      how quickly caps lock or a tapped modifier must be
#                             released to count as a tap
#   set app-window-mod <mods> Hyper + these + an app's key = next window of
#                             that line's apps, fallbacks included, in config
#                             order ("none" turns it off)

set tab ctrl+tab
set tap-ms 300
set app-window-mod cmd

# -----------------------------------------------------------------------------------------------------------

# taps
# templates:
#   [<hold key> + ...] hyper : <action>    hold the keys (optional), tap caps lock
#   <modifier> : <action>                  tap one modifier on its own
# repeated taps repeat the action

hyper : space back
shift : tab next

cmd + hyper : space cycle
cmd + shift + hyper : space cycle prev
opt + hyper : tab next
opt + shift + hyper : tab prev
ctrl + hyper : window next
ctrl + shift + hyper : window prev


# -----------------------------------------------------------------------------------------------------------

# app shortcuts
# template: hyper - <app key> : app <app name> | <optional fallback app 1> | <optional fallback app 2> | ...
# jump to the space of the first listed app that has an open window; nothing
# happens if none has one. Pressing the key again = next tab ("; tab <shortcut>")

hyper - w : app awork | absence.io | Things3
hyper - e : app Slack
hyper - r : app Calendar

hyper - a : desktop
hyper - s : app Zen | Google Chrome
hyper - d : app WebStorm | PhpStorm | CLion | Visual Studio Code ; tab ctrl+right
hyper - f : app Claude | ChatGPT
hyper - g : app Ghostty | Terminal

hyper - y : app Finder
hyper - x : app Mail | Gmail
hyper - c : app Bitwarden | Proton Pass

# -----------------------------------------------------------------------------------------------------------

# open new tab
hyper - tab : key cmd+t

# -----------------------------------------------------------------------------------------------------------
